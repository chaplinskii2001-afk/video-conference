# =====================================
# Файл конфигурации для образовательной среды
# Скопируйте этот файл в .env и заполните своими значениями
# =====================================

# =====================================
# ОСНОВНЫЕ НАСТРОЙКИ
# =====================================

# HuggingFace токен для загрузки моделей AI
# Получить можно здесь: https://huggingface.co/settings/tokens
# Требуется для загрузки PyAnnote модели
HF_TOKEN=your_huggingface_token_here

# =====================================
# ОБРАЗОВАТЕЛЬНЫЕ НАСТРОЙКИ
# =====================================

# Включить образовательный режим
# true - для учебной/исследовательской среды
EDUCATIONAL_MODE=true

# Уровень производительности для образовательной среды
# research - максимальная производительность (требует 24+ GB GPU)
# balanced - баланс производительности/качества (12+ GB GPU)
# performance - оптимизация для скорости (8+ GB GPU)
PERFORMANCE_LEVEL=balanced

# Включить экспериментальные функции
# true - разрешить экспериментальные возможности для исследований
ENABLE_EXPERIMENTAL_FEATURES=true

# =====================================
# НАСТРОЙКИ ДЛЯ ИССЛЕДОВАНИЙ
# =====================================

# Максимальный размер файла для обработки (MB)
# Увеличено для образовательной среды
MAX_FILE_SIZE_MB=1000

# Максимальное время обработки (часы)
# Для сложных задач в исследовательской среде
MAX_PROCESSING_TIME_HOURS=4

# Сохранять промежуточные результаты
# true - сохранять результаты транскрипции и диаризации
SAVE_INTERMEDIATE_RESULTS=true

# Подробное логирование
# true - детальные логи для анализа и отладки
DETAILED_LOGGING=true

# Поддержка множественных языков
# true - включить поддержку разных языков
MULTIPLE_LANGUAGE_SUPPORT=true

# =====================================
# МОНИТОРИНГ И ОТЛАДКА
# =====================================

# Включить отладочные endpoints
# true - доступ к детальной информации о системе
ENABLE_DEBUG_ENDPOINTS=true

# Включить мониторинг производительности
# true - собирать метрики производительности
ENABLE_PERFORMANCE_MONITORING=true

# Уровень логирования
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================================
# НАСТРОЙКИ GPU И ПРОИЗВОДИТЕЛЬНОСТИ
# =====================================

# CUDA устройства (для мульти-GPU систем)
# 0 - использовать первую GPU, 1 - вторую, и т.д.
CUDA_VISIBLE_DEVICES=0

# PyTorch настройки памяти
# Увеличено для образовательной среды
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:64

# =====================================
# ПРИМЕРЫ ИСПОЛЬЗОВАНИЯ
# =====================================

# Для мощного GPU (24+ GB, RTX 4090, A100):
# PERFORMANCE_LEVEL=research
# MAX_FILE_SIZE_MB=2000

# Для среднего GPU (12-16 GB, RTX 3080, 4070 Ti):
# PERFORMANCE_LEVEL=balanced
# MAX_FILE_SIZE_MB=1000

# Для бюджетного GPU (8-12 GB, RTX 3060, 3070):
# PERFORMANCE_LEVEL=performance
# MAX_FILE_SIZE_MB=500

# =====================================
# КОМАНДЫ ДЛЯ ЗАПУСКА
# =====================================

# Полная сборка и запуск:
# docker-compose up --build

# Только запуск (если образ уже собран):
# docker-compose up

# Запуск в фоне:
# docker-compose up -d

# Просмотр логов:
# docker-compose logs -f video-processor

# Остановка:
# docker-compose down

# Остановка с удалением volumes:
# docker-compose down -v